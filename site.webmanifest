{
  "id": "/adventuremap/",
  "name": "Adventure Map",
  "short_name": "Adventures",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#EFE3D0",
  "theme_color": "#EFE3D0",
  "share_target": {
    "action": "share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "tracks",
          "accept": [
            ".fit",
            ".gpx",
            "application/vnd.ant.fit",
            "application/fit",
            "application/gpx+xml",
            "application/gpx",
            "application/xml",
            "text/xml",
            "application/octet-stream",
            "*/*"
          ]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
